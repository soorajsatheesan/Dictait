{
  "name": "dictait",
  "productName": "Dictait",
  "version": "0.5.0",
  "description": "Private, local dictation for your Mac.",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "helper": "bash scripts/build-helper.sh",
    "package": "npm run helper && electron-vite build && electron-builder --mac dir --arm64"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "d3-force": "^3.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.50.0",
    "motion": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
